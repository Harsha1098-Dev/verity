# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Firebase Admin SDK Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Direct environment variables (useful for cloud deployments like Render, Railway, AWS)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# JWT / Session Secrets
SESSION_SECRET=portal1111_sacred_manifestation_jwt_secret_key_2026
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# Payment Gateway Configuration (Razorpay)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Connected Merchant Bank Account (Direct Settlement Destination)
